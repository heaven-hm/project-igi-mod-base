# Local configuration for Project I.G.I. Mod Base
# Copy this file to .env and set your local game directory:
IGI_PATH=/path/to/IGI

# Alternatively specify retail executable directly:
IGI_EXE=/path/to/IGI/igi.exe
# Local environment config

# IGI_RE Path for verification while building:
IGI_RE=/path/to//IGI-RE

